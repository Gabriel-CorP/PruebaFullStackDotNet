@model ProductoFormViewModel
@{
    var editando = Model.Id > 0;
    ViewData["Title"] = editando ? "Editar producto" : "Nuevo producto";
}
<div class="d-flex align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="bi bi-arrow-left"></i></a>
    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
</div>

<div class="card" style="max-width: 44rem">
    <div class="card-body">
        <form asp-action="@(editando ? "Edit" : "Create")" asp-route-id="@(editando ? Model.Id : (int?)null)" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Codigo" class="form-label fw-semibold"></label>
                    <input asp-for="Codigo" class="form-control text-uppercase" maxlength="30" />
                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Nombre" class="form-label fw-semibold"></label>
                    <input asp-for="Nombre" class="form-control" maxlength="150" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="500"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Precio" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Stock" class="form-label fw-semibold"></label>
                    <input asp-for="Stock" type="number" step="1" min="0" class="form-control" />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScripts")
}
