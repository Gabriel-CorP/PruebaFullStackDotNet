@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_LayoutBare";
}
<div class="min-vh-100 d-flex align-items-center justify-content-center p-3">
    <div class="card shadow-sm text-center p-5" style="max-width: 32rem">
        <i class="bi bi-exclamation-octagon text-danger display-3 mb-3"></i>
        <h1 class="h3">Ocurrió un error inesperado</h1>
        <p class="text-muted">Intente nuevamente. Si el problema continúa, comuníquese con el administrador.</p>
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="small text-muted">Código de referencia: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</div>
